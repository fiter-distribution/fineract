<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        Short-lived session tokens for Fiter Go OS (Go OS ADR 0032, option B).
        Only the SHA-256 of a token is stored; the token itself is returned once.
        Times are epoch milliseconds (UTC) so MySQL/MariaDB and PostgreSQL agree.
        chain_id groups every token renewed from one sign-in: a token presented
        again after it was renewed revokes the whole chain.
    -->
    <changeSet author="fineract" id="1">
        <createTable tableName="m_acme_session_token">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_acme_session_token_hash"/>
            </column>
            <column name="chain_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="appuser_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="chain_expires_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="replaced_at" type="BIGINT"/>
            <column name="revoked_at" type="BIGINT"/>
        </createTable>
        <createIndex indexName="ix_acme_session_token_chain" tableName="m_acme_session_token">
            <column name="chain_id"/>
        </createIndex>
        <createIndex indexName="ix_acme_session_token_chain_expiry" tableName="m_acme_session_token">
            <column name="chain_expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
