<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        Align theme tables with Fineract's AbstractAuditableCustom column conventions:
          createdby_id, created_date, lastmodifiedby_id, lastmodified_date

        Spring Data JPA Auditing (enabled in fineract-provider JPAConfig) populates these
        automatically when an entity extends AbstractAuditableCustom.
    -->

    <changeSet author="acme" id="acme_theme_audit_columns_user_pref">
        <renameColumn tableName="m_acme_user_theme_preference" oldColumnName="created_at" newColumnName="created_date" columnDataType="DATETIME"/>
        <renameColumn tableName="m_acme_user_theme_preference" oldColumnName="updated_at" newColumnName="lastmodified_date" columnDataType="DATETIME"/>
        <addColumn tableName="m_acme_user_theme_preference">
            <column name="createdby_id" type="BIGINT"/>
            <column name="lastmodifiedby_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="acme" id="acme_theme_audit_columns_skin">
        <renameColumn tableName="m_acme_theme_skin" oldColumnName="created_at" newColumnName="created_date" columnDataType="DATETIME"/>
        <renameColumn tableName="m_acme_theme_skin" oldColumnName="updated_at" newColumnName="lastmodified_date" columnDataType="DATETIME"/>
        <renameColumn tableName="m_acme_theme_skin" oldColumnName="created_by" newColumnName="createdby_id" columnDataType="BIGINT"/>
        <addColumn tableName="m_acme_theme_skin">
            <column name="lastmodifiedby_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="acme" id="acme_theme_audit_columns_admin_config">
        <addColumn tableName="m_acme_admin_theme_config">
            <column name="created_date" type="DATETIME"/>
            <column name="createdby_id" type="BIGINT"/>
        </addColumn>
        <renameColumn tableName="m_acme_admin_theme_config" oldColumnName="updated_at" newColumnName="lastmodified_date" columnDataType="DATETIME"/>
        <renameColumn tableName="m_acme_admin_theme_config" oldColumnName="updated_by" newColumnName="lastmodifiedby_id" columnDataType="BIGINT"/>
    </changeSet>

    <changeSet author="acme" id="acme_theme_audit_columns_asset">
        <renameColumn tableName="m_acme_theme_asset" oldColumnName="uploaded_at" newColumnName="created_date" columnDataType="DATETIME"/>
        <renameColumn tableName="m_acme_theme_asset" oldColumnName="uploaded_by" newColumnName="createdby_id" columnDataType="BIGINT"/>
        <addColumn tableName="m_acme_theme_asset">
            <column name="lastmodified_date" type="DATETIME"/>
            <column name="lastmodifiedby_id" type="BIGINT"/>
        </addColumn>
        <dropForeignKeyConstraint baseTableName="m_acme_theme_asset" constraintName="fk_acme_theme_asset_user"/>
        <addForeignKeyConstraint baseTableName="m_acme_theme_asset"
                                 baseColumnNames="createdby_id"
                                 constraintName="fk_m_acme_theme_asset_m_appuser"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet author="acme" id="acme_theme_rename_user_fk">
        <dropForeignKeyConstraint baseTableName="m_acme_user_theme_preference" constraintName="fk_acme_user_theme_user"/>
        <addForeignKeyConstraint baseTableName="m_acme_user_theme_preference"
                                 baseColumnNames="user_id"
                                 constraintName="fk_m_acme_user_theme_preference_m_appuser"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
